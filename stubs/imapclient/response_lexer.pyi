from _typeshed import Incomplete
from typing import Iterator

__all__ = ['TokenSource']

class TokenSource:
    lex: Incomplete
    src: Incomplete
    def __init__(self, text: list[bytes]) -> None: ...
    @property
    def current_literal(self) -> bytes | None: ...
    def __iter__(self) -> Iterator[bytes]: ...

class Lexer:
    sources: Incomplete
    current_source: LiteralHandlingIter | None
    def __init__(self, text: list[bytes]) -> None: ...
    def read_until(self, stream_i: PushableIterator, end_char: int, escape: bool = True) -> bytearray: ...
    def read_token_stream(self, stream_i: PushableIterator) -> Iterator[bytearray]: ...
    def __iter__(self) -> Iterator[bytes]: ...

class LiteralHandlingIter:
    literal: bytes | None
    src_text: Incomplete
    def __init__(self, resp_record: tuple[bytes, bytes] | bytes) -> None: ...
    def __iter__(self) -> PushableIterator: ...

class PushableIterator:
    NO_MORE: Incomplete
    it: Incomplete
    pushed: list[int]
    def __init__(self, it: bytes) -> None: ...
    def __iter__(self) -> PushableIterator: ...
    def __next__(self) -> int: ...
    next = __next__
    def push(self, item: int) -> None: ...
